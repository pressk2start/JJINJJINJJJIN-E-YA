# swing.service — systemd 유닛 템플릿 (미설치 상태).
# 서버에 설치·활성화는 hash + robustness PASS + prospective 설정 완료 이후 사용자 손으로만.
# 이 파일은 DEPLOY_BLUEPRINT.md에 따른 격리 서비스 예시.
#
# 설치 (사용자 손, 별도 timing):
#   sudo cp swing.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable swing.timer  # (별도 .timer로 반복 실행 권장)
#
# 실행:
#   sudo systemctl start swing.service
#
# 중지:
#   sudo systemctl stop swing.service
#
# ⚠ 기존 upbit-bot / momentum-scanner / momentum-clm 서비스와 완전 분리.
# ⚠ AUTO_TRADE 환경변수는 systemd EnvironmentFile 로 관리 (기본 0).

[Unit]
Description=Swing Strategy Bot (v1.7 protocol, safety-gated)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/bot/swing
EnvironmentFile=-/home/ubuntu/bot/.env
Environment="AUTO_TRADE=0"
ExecStart=/usr/bin/python3 /home/ubuntu/bot/swing/live_swing.py
StandardOutput=append:/var/log/swing.log
StandardError=append:/var/log/swing.log
# 실주문 arm 하려면 사용자가 별도 override 필요:
#   sudo systemctl edit swing.service
#   [Service]
#   Environment="AUTO_TRADE=1"
#   ExecStart=
#   ExecStart=/usr/bin/python3 /home/ubuntu/bot/swing/live_swing.py --arm-live
# + .sealed_spec_marker · .prospective_pass_marker 파일 존재해야 실제로 실주문 진행.

[Install]
WantedBy=multi-user.target
